# Postgres: admin owns the schemas/tables; app is the limited role pipelines use
PG_ADMIN_USER=dif_admin
PG_ADMIN_PASSWORD=
PG_DB=dif
APP_DB_USER=dif_app
APP_DB_PASSWORD=

# Dagster metadata lives in its own role + database
DAGSTER_PG_USER=dagster
DAGSTER_PG_PASSWORD=
DAGSTER_PG_DB=dagster

# Local `dg dev` only: absolute path, set per machine
DAGSTER_HOME=